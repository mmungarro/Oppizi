  "item": [
    {
      "name": "Get POIs",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Validate reponse time unde 1000ms \r",
              "pm.test(\"Validate response time under 1000ms\", function(){\r",
              "    pm.expect(pm.response.responseTime).to.be.below(1000);\r",
              "\r",
              "});\r",
              "\r",
              "//Validate HTTP Response code to be = 200\r",
              "pm.test(\"Validate response code = 200\", function(){\r",
              "    pm.expect(pm.response.to.have.status(200));\r",
              "\r",
              "})\r",
              "\r",
              "//validate shema from POI response\r",
              "pm.test(\"valida schema json\", function () {\r",
              "\r",
              "    const data = pm.response.json();\r",
              "\r",
              "    pm.expect(data).to.be.an(\"array\");\r",
              "\r",
              "    const firstObject = data[0];\r",
              "\r",
              "    const schemaText = pm.collectionVariables.get(\"col_poiSchema\");\r",
              "    const poiobject = JSON.parse(schemaText);\r",
              "\r",
              "    pm.expect(firstObject).to.have.jsonSchema(poiobject);\r",
              "});\r",
              "\r",
              "//Validate bussines logic rules\r",
              " \r",
              "//  1. Validate POI to has elements.\r",
              "pm.test(\"POI has at least 1 element\", function () {\r",
              "    const data = pm.response.json();\r",
              "    pm.expect(data.length).to.be.above(0);\r",
              "});\r",
              "\r",
              "//   2. Validate if Town name is equal La Paz\r",
              "pm.test(\"Validate if chargers are in La Paz\", function(){\r",
              "  \r",
              "    const json = pm.response.json();\r",
              "    json.forEach(poi => {\r",
              "        pm.expect(poi.AddressInfo.Town).to.eql(\"La Paz\");\r",
              "\r",
              "}); \r",
              "\r",
              "\r",
              "\r",
              "})"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{col_baseUrl}}/poi?key={{col_key}}&boundingbox={{coll_boundingBox}}",
          "host": [
            "{{col_baseUrl}}"
          ],
          "path": [
            "poi"
